{
  "version": 1,
  "statuses": ["dev", "alpha", "beta", "production"],
  "contract": {
    "runtimeModels": {
      "static": "Server-rendered semantics with no component runtime.",
      "conditional-native": "Native HTML remains usable; JavaScript is loaded only for enhanced configurations.",
      "custom-element": "A custom element coordinates state and exposes a framework-independent DOM API."
    },
    "publicSurface": [
      "parts",
      "package export",
      "DOM hooks",
      "DOM properties and methods",
      "events",
      "behaviour CSS"
    ],
    "privateSurface": [
      "SSR context",
      "runtime configuration attributes",
      "loading condition"
    ],
    "deliverySurface": [
      "documentation",
      "status",
      "public demo",
      "browser fixture",
      "changeset"
    ],
    "testTaxonomy": {
      "static": ["Astro render", "browser semantics", "accessibility"],
      "conditional-native": [
        "runtime unit",
        "Astro render",
        "no-JavaScript browser path",
        "enhanced browser path",
        "accessibility"
      ],
      "custom-element": [
        "runtime unit",
        "reconnection and cleanup",
        "DOM API and events",
        "Astro render",
        "browser interaction",
        "accessibility"
      ]
    },
    "diagnosticOwnership": {
      "SSR warnings": "Component render tests beside other Astro suites",
      "runtime warnings": "Runtime unit tests beside the owning controller",
      "dev-toolbar diagnostics": "Scanner rule tests plus toolbar integration tests"
    },
    "changesets": "Required for consumer-visible API, behaviour, semantics, styling-hook or status changes."
  },
