---
import "../styles/index.css";
import "../styles/browser-fixtures.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} browser fixture</title>
  </head>
  <body>
    <main data-browser-fixture={title.toLowerCase()}>
      <slot />
    </main>
  </body>
</html>
