---
import * as Popover from "@ormo/primitives/popover";
import "./index.css";
---

<div class="popover-example">
  <Popover.Root>
    <Popover.Trigger class="popover-trigger button">Filters</Popover.Trigger>

    <Popover.Content
      class="popover-content"
      side="bottom"
      align="start"
      sideOffset={8}
    >
      <Popover.Title class="popover-title">Filters</Popover.Title>
      <Popover.Description class="popover-description">
        Narrow the results by keyword.
      </Popover.Description>

      <form class="popover-form">
        <label class="popover-label" for="popover-keyword">Keyword</label>
        <input
          class="popover-input"
          id="popover-keyword"
          name="keyword"
          autocomplete="off"
        />
        <div class="popover-actions button-group button-group--end">
          <Popover.Close class="popover-button button button--secondary">
            Cancel
          </Popover.Close>
          <Popover.Close
            class="popover-button popover-primary button"
            value="apply"
          >
            Apply
          </Popover.Close>
        </div>
      </form>
    </Popover.Content>
  </Popover.Root>
</div>
