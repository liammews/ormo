---
import * as Popover from "@ormo/primitives/popover";
import "./index.css";
---

<div class="popover-example" data-programmatic-popover>
  <Popover.Root id="programmatic-popover">
    <Popover.Trigger class="popover-trigger button">
      Open with Trigger
    </Popover.Trigger>

    <Popover.Content class="popover-content" sideOffset={8}>
      <Popover.Title class="popover-title">Programmatic control</Popover.Title>
      <Popover.Description class="popover-description">
        Root exposes show(), hide(), and toggle() after it connects.
      </Popover.Description>
    </Popover.Content>
  </Popover.Root>

  <div class="popover-trigger-group button-group">
    <button
      type="button"
      class="popover-trigger-secondary button button--secondary"
      data-show-popover
    >
      show()
    </button>
    <button
      type="button"
      class="popover-trigger-secondary button button--secondary"
      data-hide-popover
    >
      hide()
    </button>
  </div>
  <p class="popover-status" aria-live="polite" data-popover-status></p>
</div>

<script>
  for (const controller of document.querySelectorAll(
    "[data-programmatic-popover]",
  )) {
    const root = controller.querySelector("ormo-popover");
    const status = controller.querySelector("[data-popover-status]");
    const show = controller.querySelector("[data-show-popover]");
    const hide = controller.querySelector("[data-hide-popover]");

    root?.addEventListener("ormo:popover-open-change", (event) => {
      const detail = event.detail;
      if (status) {
        status.textContent = detail.open
          ? `Opened (${detail.reason})`
          : `Closed (${detail.reason})`;
      }
    });

    show?.addEventListener("click", () => root?.show());
    hide?.addEventListener("click", () => root?.hide());
  }
</script>
