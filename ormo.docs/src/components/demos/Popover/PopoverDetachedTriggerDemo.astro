---
import * as Popover from "@ormo/primitives/popover";
import "./index.css";
---

<div class="popover-example">
  <div class="popover-trigger-group button-group">
    <Popover.Trigger class="popover-trigger button" for="account-popover">
      Open from toolbar
    </Popover.Trigger>
    <Popover.Trigger
      class="popover-trigger-secondary button button--secondary"
      for="account-popover"
    >
      Open from menu
    </Popover.Trigger>
  </div>

  <Popover.Root id="account-popover">
    <Popover.Content class="popover-content" sideOffset={8}>
      <Popover.Title class="popover-title">Account</Popover.Title>
      <Popover.Description class="popover-description">
        Detached triggers share one Root and restore focus to the invoker.
      </Popover.Description>
    </Popover.Content>
  </Popover.Root>
</div>
