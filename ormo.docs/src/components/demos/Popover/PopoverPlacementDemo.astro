---
import * as Popover from "@ormo/primitives/popover";
import "./index.css";
---

<div class="popover-example">
  <div class="popover-trigger-group button-group">
    <Popover.Root>
      <Popover.Trigger class="popover-trigger button">Top</Popover.Trigger>
      <Popover.Content
        class="popover-content"
        side="top"
        align="center"
        sideOffset={8}
      >
        <Popover.Title class="popover-title">Top</Popover.Title>
        <Popover.Description class="popover-description">
          Anchored above the trigger.
        </Popover.Description>
      </Popover.Content>
    </Popover.Root>

    <Popover.Root>
      <Popover.Trigger class="popover-trigger button">Right</Popover.Trigger>
      <Popover.Content
        class="popover-content"
        side="right"
        align="start"
        sideOffset={8}
      >
        <Popover.Title class="popover-title">Right</Popover.Title>
        <Popover.Description class="popover-description">
          Anchored to the right of the trigger.
        </Popover.Description>
      </Popover.Content>
    </Popover.Root>
  </div>
</div>
