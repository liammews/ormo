---
import * as Popover from "@ormo/primitives/popover";
import "./index.css";
---

<div class="popover-example">
  <Popover.Root>
    <Popover.Trigger class="popover-trigger button">
      <svg
        class="popover-icon"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M2 3.5h12M4 8h8M6 12.5h4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
      <span>Filters</span>
    </Popover.Trigger>

    <Popover.Content class="popover-content" sideOffset={8}>
      <Popover.Title class="popover-title">Filters</Popover.Title>
      <Popover.Description class="popover-description">
        Trigger owns the button. Slot content is for icons and labels.
      </Popover.Description>
      <div class="popover-actions button-group button-group--end">
        <Popover.Close class="popover-button button button--secondary">
          Close
        </Popover.Close>
      </div>
    </Popover.Content>
  </Popover.Root>
</div>
