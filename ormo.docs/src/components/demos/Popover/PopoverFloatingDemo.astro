---
import * as Popover from "@ormo/primitives/popover";
import "./PopoverDemo.css";
---

<div class="popover-demo" data-popover-demo="floating">
  <Popover.Root positioning="floating">
    <Popover.Trigger class="popover-trigger">Floating UI</Popover.Trigger>

    <Popover.Content
      class="popover-content"
      side="bottom"
      align="start"
      sideOffset={8}
    >
      <Popover.Title class="popover-title">Floating UI</Popover.Title>
      <Popover.Description class="popover-description">
        Opt in with the floating import and positioning="floating".
      </Popover.Description>
      <div class="popover-actions">
        <Popover.Close class="popover-button">Close</Popover.Close>
      </div>
    </Popover.Content>
  </Popover.Root>
</div>

<script>
  import "@ormo/primitives/popover/floating";
</script>
