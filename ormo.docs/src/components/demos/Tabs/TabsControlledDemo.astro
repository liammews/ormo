---
import * as Tabs from "@ormo/primitives/tabs";
import "./index.css";
import "./controlled.css";
---

<div class="tabs-controlled-row">
  <Tabs.Root class="tabs" id="account-tabs" defaultValue="overview">
    <Tabs.List class="tabs-list" aria-label="Controlled account">
      <Tabs.Tab class="tabs-tab" value="overview">Overview</Tabs.Tab>
      <Tabs.Tab class="tabs-tab" value="projects">Projects</Tabs.Tab>
      <Tabs.Tab class="tabs-tab" value="billing">Billing</Tabs.Tab>
    </Tabs.List>
    <Tabs.Panel class="tabs-panel" value="overview">
      Overview selected from the script or the tablist.
    </Tabs.Panel>
    <Tabs.Panel class="tabs-panel" value="projects">
      Projects selected from the script or the tablist.
    </Tabs.Panel>
    <Tabs.Panel class="tabs-panel" value="billing">
      Billing selected from the script or the tablist.
    </Tabs.Panel>
  </Tabs.Root>

  <button
    type="button"
    class="tabs-controlled-button"
    data-tabs-select="projects"
  >
    Select projects
  </button>
</div>

<script>
  const tabs = document.getElementById("account-tabs");
  const button = document.querySelector("[data-tabs-select='projects']");

  button?.addEventListener("click", () => {
    if (tabs && "value" in tabs) {
      tabs.value = "projects";
    }
  });
</script>
