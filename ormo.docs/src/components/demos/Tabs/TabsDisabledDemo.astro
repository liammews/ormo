---
import * as Tabs from "@ormo/primitives/tabs";
import "./index.css";
---

<Tabs.Root class="tabs" defaultValue="overview">
  <Tabs.List class="tabs-list" aria-label="Workspace">
    <Tabs.Tab class="tabs-tab" value="overview">Overview</Tabs.Tab>
    <Tabs.Tab class="tabs-tab" value="projects" disabled>Projects</Tabs.Tab>
    <Tabs.Tab class="tabs-tab" value="billing">Billing</Tabs.Tab>
  </Tabs.List>
  <Tabs.Panel class="tabs-panel" value="overview">
    Available workspace summary.
  </Tabs.Panel>
  <Tabs.Panel class="tabs-panel" value="projects">
    Projects are currently unavailable.
  </Tabs.Panel>
  <Tabs.Panel class="tabs-panel" value="billing">
    Invoices and payment methods.
  </Tabs.Panel>
</Tabs.Root>
