---
import * as Breadcrumbs from "@ormo/primitives/breadcrumbs";
import "../css-separators.css";
import "../index.css";
---

<div data-breadcrumbs-demo="css-separators">
  <Breadcrumbs.Root class="breadcrumbs breadcrumbs-css" label="Gallery trail">
    <Breadcrumbs.List class="breadcrumbs-list">
      <Breadcrumbs.Item class="breadcrumbs-item">
        <Breadcrumbs.Link class="breadcrumbs-link" href="/gallery">
          Galleries
        </Breadcrumbs.Link>
      </Breadcrumbs.Item>
      <Breadcrumbs.Item class="breadcrumbs-item">
        <Breadcrumbs.Link class="breadcrumbs-link" href="/gallery/antarctica">
          Antarctica
        </Breadcrumbs.Link>
      </Breadcrumbs.Item>
      <Breadcrumbs.Item class="breadcrumbs-item">
        <Breadcrumbs.Page class="breadcrumbs-page">Penguins</Breadcrumbs.Page>
      </Breadcrumbs.Item>
    </Breadcrumbs.List>
  </Breadcrumbs.Root>
</div>
