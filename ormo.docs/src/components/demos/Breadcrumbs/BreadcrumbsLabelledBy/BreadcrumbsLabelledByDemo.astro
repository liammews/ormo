---
import { ChevronRight } from "@lucide/astro";
import * as Breadcrumbs from "@ormo/primitives/breadcrumbs";
import "../index.css";
import "./labelled-by.css";
---

<div data-breadcrumbs-demo="labelled-by">
  <Breadcrumbs.Root class="breadcrumbs" aria-labelledby="breadcrumb-heading">
    <p class="breadcrumbs-heading" id="breadcrumb-heading">Navigation</p>
    <Breadcrumbs.List class="breadcrumbs-list">
      <Breadcrumbs.Item class="breadcrumbs-item">
        <Breadcrumbs.Link class="breadcrumbs-link" href="/"
          >Home</Breadcrumbs.Link
        >
      </Breadcrumbs.Item>
      <Breadcrumbs.Separator class="breadcrumbs-separator">
        <ChevronRight
          class="breadcrumbs-separator-icon"
          size={14}
          aria-hidden="true"
        />
      </Breadcrumbs.Separator>
      <Breadcrumbs.Item class="breadcrumbs-item">
        <Breadcrumbs.Link class="breadcrumbs-link" href="/electronics">
          Docs
        </Breadcrumbs.Link>
      </Breadcrumbs.Item>
      <Breadcrumbs.Separator class="breadcrumbs-separator">
        <ChevronRight
          class="breadcrumbs-separator-icon"
          size={14}
          aria-hidden="true"
        />
      </Breadcrumbs.Separator>
      <Breadcrumbs.Item class="breadcrumbs-item">
        <Breadcrumbs.Page class="breadcrumbs-page">Contribute</Breadcrumbs.Page>
      </Breadcrumbs.Item>
    </Breadcrumbs.List>
  </Breadcrumbs.Root>
</div>
