---
import { ChevronRight } from "@lucide/astro";
import * as Breadcrumbs from "@ormo/primitives/breadcrumbs";
import "../index.css";
---

<div data-breadcrumbs-demo="default">
  <Breadcrumbs.Root class="breadcrumbs">
    <Breadcrumbs.List class="breadcrumbs-list">
      <Breadcrumbs.Item class="breadcrumbs-item">
        <Breadcrumbs.Link class="breadcrumbs-link" href="/books">
          Home
        </Breadcrumbs.Link>
      </Breadcrumbs.Item>
      <Breadcrumbs.Separator class="breadcrumbs-separator">
        <ChevronRight
          class="breadcrumbs-separator-icon"
          size={14}
          aria-hidden="true"
        />
      </Breadcrumbs.Separator>
      <Breadcrumbs.Item class="breadcrumbs-item">
        <Breadcrumbs.Link class="breadcrumbs-link" href="/books/sciencefiction">
          Docs
        </Breadcrumbs.Link>
      </Breadcrumbs.Item>
      <Breadcrumbs.Separator class="breadcrumbs-separator">
        <ChevronRight
          class="breadcrumbs-separator-icon"
          size={14}
          aria-hidden="true"
        />
      </Breadcrumbs.Separator>
      <Breadcrumbs.Item class="breadcrumbs-item">
        <Breadcrumbs.Page class="breadcrumbs-page">Components</Breadcrumbs.Page>
      </Breadcrumbs.Item>
    </Breadcrumbs.List>
  </Breadcrumbs.Root>
</div>
