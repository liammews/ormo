---
import * as Field from "@ormo/primitives/field";
import "./index.css";
---

<Field.Root class="field" disabled name="email">
  <Field.Label class="field-label" for="disabled-email">
    Email address
  </Field.Label>
  <Field.Control
    class="field-input"
    id="disabled-email"
    type="email"
    value="you@example.com"
    aria-describedby="disabled-email-description"
  />
  <Field.Description class="field-description" id="disabled-email-description">
    This field is currently unavailable.
  </Field.Description>
</Field.Root>
