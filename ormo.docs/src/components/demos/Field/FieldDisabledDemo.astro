---
import * as Field from "@ormo/primitives/field";
import { Input } from "@ormo/primitives/input";
import "./FieldDemo.css";
---

<Field.Root class="field-demo" disabled>
  <Field.Label class="field-demo-label" for="field-disabled-demo-email">
    Email address
  </Field.Label>
  <Input
    class="field-demo-input"
    id="field-disabled-demo-email"
    name="email"
    type="email"
    value="you@example.com"
    aria-describedby="field-disabled-demo-description"
    disabled
  />
  <Field.Description
    class="field-demo-description"
    id="field-disabled-demo-description"
  >
    This field is currently unavailable.
  </Field.Description>
</Field.Root>
