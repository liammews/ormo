---
import * as Field from "@ormo/primitives/field";
import "./FieldDemo.css";
---

<Field.Root class="field-demo" validationMode="onBlur" name="email" required>
  <Field.Label class="field-demo-label" for="field-default-demo-email">
    Email address
  </Field.Label>
  <Field.Control
    class="field-demo-input"
    id="field-default-demo-email"
    type="email"
    autocomplete="email"
    placeholder="you@example.com"
    aria-describedby="field-default-demo-description field-default-demo-error"
  />
  <Field.Description
    class="field-demo-description"
    id="field-default-demo-description"
  >
    We’ll only use this to contact you about your account.
  </Field.Description>
  <Field.Error
    class="field-demo-error"
    id="field-default-demo-error"
    match="valueMissing"
  >
    Enter your email address.
  </Field.Error>
</Field.Root>
