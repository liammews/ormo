---
import * as Field from "@ormo/primitives/field";
import { Input } from "@ormo/primitives/input";
import "./FieldDemo.css";
---

<Field.Root class="field-demo" invalid>
  <Field.Label class="field-demo-label" for="field-error-demo-email">
    Email address
  </Field.Label>
  <Input
    class="field-demo-input"
    id="field-error-demo-email"
    name="email"
    type="email"
    value="not-an-email"
    autocomplete="email"
    aria-invalid="true"
    aria-describedby="field-error-demo-message"
  />
  <Field.Error class="field-demo-error" id="field-error-demo-message">
    Enter an email address in the format name@example.com.
  </Field.Error>
</Field.Root>
