---
import * as Tooltip from "@ormo/primitives/tooltip";
import "./index.css";
---

<div class="tooltip-example" data-tooltip-demo="disabled">
  <Tooltip.Root disabled>
    <Tooltip.Trigger class="tooltip-trigger button" disabled>
      Disabled
    </Tooltip.Trigger>
    <Tooltip.Content class="tooltip-content" sideOffset={10}>
      You should not see this
    </Tooltip.Content>
  </Tooltip.Root>
</div>
