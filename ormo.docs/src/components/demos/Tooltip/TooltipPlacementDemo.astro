---
import * as Tooltip from "@ormo/primitives/tooltip";
import "./index.css";
---

<div class="tooltip-example" data-tooltip-demo="placement">
  <div class="tooltip-trigger-group button-group">
    <Tooltip.Root>
      <Tooltip.Trigger class="tooltip-trigger button button--secondary"
        >Top</Tooltip.Trigger
      >
      <Tooltip.Content class="tooltip-content" side="top" sideOffset={10}>
        Top
      </Tooltip.Content>
    </Tooltip.Root>

    <Tooltip.Root>
      <Tooltip.Trigger class="tooltip-trigger button button--secondary"
        >Right</Tooltip.Trigger
      >
      <Tooltip.Content class="tooltip-content" side="right" sideOffset={10}>
        Right
      </Tooltip.Content>
    </Tooltip.Root>

    <Tooltip.Root>
      <Tooltip.Trigger class="tooltip-trigger button button--secondary"
        >Bottom</Tooltip.Trigger
      >
      <Tooltip.Content class="tooltip-content" side="bottom" sideOffset={10}>
        Bottom
      </Tooltip.Content>
    </Tooltip.Root>

    <Tooltip.Root>
      <Tooltip.Trigger class="tooltip-trigger button button--secondary"
        >Left</Tooltip.Trigger
      >
      <Tooltip.Content class="tooltip-content" side="left" sideOffset={10}>
        Left
      </Tooltip.Content>
    </Tooltip.Root>
  </div>
</div>
