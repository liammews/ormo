---
import * as Field from "@ormo/primitives/field";
import * as PasswordField from "@ormo/primitives/password-field";
import "./index.css";
---

<form class="password-field-demo" method="post" data-password-field-form>
  <Field.Root>
    <Field.Label class="password-field-label">Password</Field.Label>
    <Field.Description class="password-field-description">
      Enter the password for your account.
    </Field.Description>
    <PasswordField.Root class="password-field-root">
      <PasswordField.Input
        class="password-field-input"
        name="password"
        autocomplete="current-password"
        required
      />
      <PasswordField.Toggle
        class="password-field-toggle"
        showLabel="Show password"
        hideLabel="Hide password"
      >
        <svg
          class="password-field-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            data-icon-visible
            d="M3 3l18 18M10.6 10.7a2 2 0 002.7 2.7M9.9 4.2A10.5 10.5 0 0112 4c5 0 9 4.5 10 8a14.8 14.8 0 01-2.1 4.1M6.6 6.6A14.5 14.5 0 002 12c1 3.5 5 8 10 8a9.8 9.8 0 004.1-.9"
          ></path>
          <path
            data-icon-hidden
            d="M2 12c1-3.5 5-8 10-8s9 4.5 10 8c-1 3.5-5 8-10 8S3 15.5 2 12zM12 9a3 3 0 100 6 3 3 0 000-6z"
          ></path>
        </svg>
      </PasswordField.Toggle>
    </PasswordField.Root>
  </Field.Root>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>(
    "[data-password-field-form]",
  )) {
    if (form.dataset.demoSubmitGuard === "true") continue;
    form.dataset.demoSubmitGuard = "true";
    form.addEventListener("submit", (event) => event.preventDefault());
  }
</script>
