---
import * as Slider from "@ormo/primitives/slider";
import "./index.css";
---

<Slider.Root
  class="slider"
  aria-label="Price range"
  defaultValue={[20, 80]}
  min={0}
  max={100}
  step={5}
>
  <Slider.Track class="slider-track">
    <Slider.Range class="slider-range" />
  </Slider.Track>
  <Slider.Thumb class="slider-thumb" aria-label="Minimum price" />
  <Slider.Thumb class="slider-thumb" aria-label="Maximum price" />
</Slider.Root>
