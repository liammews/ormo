---
import * as Avatar from "@ormo/primitives/avatar";
import "./AvatarDemo.css";
---

<Avatar.Root class="avatar-demo" role="img" aria-label="Guest user">
  <Avatar.Fallback class="avatar-demo-fallback">
    <svg
      class="avatar-demo-fallback-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      aria-hidden="true"
    >
      <circle cx="12" cy="8" r="3.25"></circle>
      <path d="M5.5 19.25c1.6-3.1 3.9-4.5 6.5-4.5s4.9 1.4 6.5 4.5"></path>
    </svg>
  </Avatar.Fallback>
</Avatar.Root>
