---
import * as Avatar from "@ormo/primitives/avatar";
import "./index.css";
---

<Avatar.Root class="avatar" role="img" aria-label="Ada Lovelace">
  <Avatar.Image
    class="avatar-image"
    src="https://images.unsplash.com/photo-1543610892-0b1f7e6d8ac1?w=128&h=128&dpr=2&q=80"
    alt=""
    width="40"
    height="40"
  />
  <Avatar.Fallback class="avatar-fallback" delay={600}>AL</Avatar.Fallback>
</Avatar.Root>
