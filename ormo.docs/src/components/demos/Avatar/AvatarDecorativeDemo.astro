---
import * as Avatar from "@ormo/primitives/avatar";
import "./index.css";
---

<div class="avatar-person">
  <Avatar.Root class="avatar" aria-hidden="true">
    <Avatar.Image
      class="avatar-image"
      src="https://images.unsplash.com/photo-1543610892-0b1f7e6d8ac1?w=128&h=128&dpr=2&q=80"
      alt=""
      width="40"
      height="40"
    />
    <Avatar.Fallback class="avatar-fallback">AL</Avatar.Fallback>
  </Avatar.Root>
  <span class="avatar-person-name">Ada Lovelace</span>
</div>
