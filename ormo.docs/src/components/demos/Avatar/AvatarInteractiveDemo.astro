---
import * as Avatar from "@ormo/primitives/avatar";
import { Button } from "@ormo/primitives/button";
import "./AvatarDemo.css";
---

<div class="avatar-demo-row">
  <Button class="avatar-demo-trigger" aria-label="View Ada Lovelace's profile">
    <Avatar.Root class="avatar-demo" aria-hidden="true">
      <Avatar.Image
        class="avatar-demo-image"
        src="https://images.unsplash.com/photo-1543610892-0b1f7e6d8ac1?w=128&h=128&dpr=2&q=80"
        alt=""
        width="40"
        height="40"
      />
      <Avatar.Fallback class="avatar-demo-fallback">AL</Avatar.Fallback>
    </Avatar.Root>
  </Button>

  <a
    class="avatar-demo-trigger"
    href="#ada-lovelace"
    aria-label="Ada Lovelace's profile"
  >
    <Avatar.Root class="avatar-demo" aria-hidden="true">
      <Avatar.Image
        class="avatar-demo-image"
        src="https://images.unsplash.com/photo-1543610892-0b1f7e6d8ac1?w=128&h=128&dpr=2&q=80"
        alt=""
        width="40"
        height="40"
      />
      <Avatar.Fallback class="avatar-demo-fallback">AL</Avatar.Fallback>
    </Avatar.Root>
  </a>
</div>
