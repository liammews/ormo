---
import * as Dialog from "@ormo/primitives/dialog";
import "./index.css";
---

<div>
  <Dialog.Root disablePointerDismissal>
    <Dialog.Trigger class="dialog-trigger button"
      >View persistent notification</Dialog.Trigger
    >
    <Dialog.Content class="dialog-content">
      <Dialog.Title class="dialog-title">Notifications</Dialog.Title>
      <Dialog.Description class="dialog-description">
        You are all caught up. Good job!
      </Dialog.Description>
      <div class="dialog-actions button-group button-group--end">
        <Dialog.Close class="dialog-button button">Close</Dialog.Close>
      </div>
    </Dialog.Content>
  </Dialog.Root>
</div>
