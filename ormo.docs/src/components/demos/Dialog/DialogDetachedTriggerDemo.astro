---
import * as Dialog from "@ormo/primitives/dialog";
import "./index.css";
---

<div data-profile-editor>
  <div class="dialog-trigger-group button-group" aria-label="Profile shortcuts">
    <Dialog.Trigger class="dialog-trigger button" for="profile-dialog">
      Open from toolbar
    </Dialog.Trigger>
    <Dialog.Trigger
      class="dialog-trigger-secondary button button--secondary"
      for="profile-dialog"
    >
      Open from account menu
    </Dialog.Trigger>
  </div>

  <Dialog.Root id="profile-dialog">
    <Dialog.Content class="dialog-content">
      <Dialog.Title class="dialog-title">Profile details</Dialog.Title>
      <Dialog.Description class="dialog-description">
        Your public profile is visible to everyone in your workspace.
      </Dialog.Description>
      <div class="dialog-actions button-group button-group--end">
        <Dialog.Close class="dialog-button button button--secondary">
          Close
        </Dialog.Close>
      </div>
    </Dialog.Content>
  </Dialog.Root>
</div>
