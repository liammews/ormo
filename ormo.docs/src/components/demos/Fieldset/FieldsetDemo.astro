---
import * as Field from "@ormo/primitives/field";
import * as Fieldset from "@ormo/primitives/fieldset";
import "./index.css";
---

<form class="fieldset-demo" id="personal-details-form">
  <Fieldset.Root
    class="fieldset"
    name="personal-details"
    aria-describedby="personal-details-hint"
  >
    <Fieldset.Legend class="fieldset-legend">
      Personal details
    </Fieldset.Legend>
    <p class="fieldset-hint" id="personal-details-hint">
      Tell us who this account belongs to.
    </p>
    <div class="fieldset-fields">
      <Field.Root class="fieldset-field">
        <Field.Label class="fieldset-label" for="first-name">
          First name
        </Field.Label>
        <Field.Control
          class="fieldset-input"
          id="first-name"
          name="first-name"
          type="text"
          required
          placeholder="Marcus"
          autocomplete="given-name"
        />
      </Field.Root>
      <Field.Root class="fieldset-field">
        <Field.Label class="fieldset-label" for="last-name">
          Last name
        </Field.Label>
        <Field.Control
          class="fieldset-input"
          id="last-name"
          name="last-name"
          type="text"
          required
          placeholder="Syring"
          autocomplete="family-name"
        />
      </Field.Root>
    </div>
  </Fieldset.Root>
</form>
