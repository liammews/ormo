---
import * as Select from "@ormo/primitives/select";
import "./index.css";
import { Check, ChevronDown, X } from "@lucide/astro";
---

<div class="select-field">
  <label class="select-label" for="country-control">Country</label>

  <Select.Root class="select" id="country" name="country" defaultValue="fr">
    <div class="select-actions">
      <Select.Trigger class="select-trigger">
        <Select.Value class="select-value" placeholder="Choose a country" />
        <Select.Icon class="select-icon"><ChevronDown size={14} /></Select.Icon>
      </Select.Trigger>

      <Select.Clear class="select-clear" aria-label="Clear country">
        <span aria-hidden="true"><X size={12} /></span>
      </Select.Clear>
    </div>

    <Select.Content class="select-content" sideOffset={6}>
      <Select.Group class="select-group">
        <Select.GroupLabel class="select-group-label">
          Europe
        </Select.GroupLabel>
        <Select.Item class="select-item" value="fr">
          <span>France</span>
          <Select.ItemIndicator class="select-item-indicator">
            <Check size={14} />
          </Select.ItemIndicator>
        </Select.Item>
        <Select.Item class="select-item" value="gb">
          <span>United Kingdom</span>
          <Select.ItemIndicator class="select-item-indicator">
            <Check size={14} />
          </Select.ItemIndicator>
        </Select.Item>
      </Select.Group>

      <Select.Group class="select-group">
        <Select.GroupLabel class="select-group-label">
          North America
        </Select.GroupLabel>
        <Select.Item class="select-item" value="ca">
          <span>Canada</span>
          <Select.ItemIndicator class="select-item-indicator">
            <Check size={14} />
          </Select.ItemIndicator>
        </Select.Item>
        <Select.Item class="select-item" value="us" disabled>
          <span>United States</span>
          <Select.ItemIndicator class="select-item-indicator">
            <Check size={14} />
          </Select.ItemIndicator>
        </Select.Item>
      </Select.Group>
    </Select.Content>
  </Select.Root>
</div>
