---
import * as Select from "@ormo/primitives/select";
import "./index.css";
---

<div class="select-field">
  <label class="select-label" for="native-country">Country</label>
  <Select.Root
    native
    class="select-native"
    id="native-country"
    name="native-country"
    defaultValue="fr"
  >
    <Select.Item value="">Choose a country</Select.Item>
    <Select.Group>
      <Select.GroupLabel>Europe</Select.GroupLabel>
      <Select.Item value="fr">France</Select.Item>
      <Select.Item value="gb">United Kingdom</Select.Item>
    </Select.Group>
    <Select.Separator />
    <Select.Item value="ca">Canada</Select.Item>
  </Select.Root>
</div>
