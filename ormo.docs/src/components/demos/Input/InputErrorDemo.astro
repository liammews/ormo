---
import { Input } from "@ormo/primitives/input";
import "./index.css";
import "./error.css";
---

<div class="input-field">
  <label class="input-label" for="recovery-email"> Email address </label>
  <Input
    class="input"
    id="recovery-email"
    name="email"
    type="email"
    value="not-an-email"
    aria-invalid="true"
    aria-describedby="recovery-email-error recovery-email-hint"
  />
  <p class="input-hint input-error" id="recovery-email-error">
    Enter an email address in the format name@example.com.
  </p>
  <p class="input-hint" id="recovery-email-hint">
    We’ll only use this to contact you about your account.
  </p>
</div>
