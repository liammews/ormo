---
import { Input } from "@ormo/primitives/input";
import "./InputErrorDemo.css";
---

<div class="input-demo">
  <label class="input-demo-label" for="input-error-demo-email">
    Email address
  </label>
  <Input
    class="input-demo-input"
    id="input-error-demo-email"
    name="email"
    type="email"
    value="not-an-email"
    aria-invalid="true"
    aria-describedby="input-error-demo-email-message"
  />
  <p
    class="input-demo-hint input-demo-error"
    id="input-error-demo-email-message"
  >
    Enter an email address in the format name@example.com.
  </p>
</div>
