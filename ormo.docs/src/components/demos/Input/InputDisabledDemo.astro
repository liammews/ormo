---
import { Input } from "@ormo/primitives/input";
import "./index.css";
import "./disabled.css";
---

<div class="input-field">
  <label class="input-label" for="account-email"> Email address </label>
  <Input
    class="input"
    id="account-email"
    name="email"
    type="email"
    value="you@example.com"
    aria-describedby="account-email-hint"
    disabled
  />
  <p class="input-hint" id="account-email-hint">
    This field is currently unavailable.
  </p>
</div>
