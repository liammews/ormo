---
import * as AlertDialog from "@ormo/primitives/alert-dialog";
import "./index.css";
---

<div data-project-deletion>
  <AlertDialog.Root>
    <AlertDialog.Trigger class="alert-dialog-trigger button">
      Delete project
    </AlertDialog.Trigger>

    <AlertDialog.Content class="alert-dialog-content">
      <AlertDialog.Title class="alert-dialog-title">
        Delete this project?
      </AlertDialog.Title>
      <AlertDialog.Description class="alert-dialog-description">
        This permanently deletes the project and all of its data. This action
        cannot be undone.
      </AlertDialog.Description>

      <div
        class="alert-dialog-actions button-group button-group--compact button-group--end"
      >
        <AlertDialog.Cancel
          class="alert-dialog-button alert-dialog-cancel button button--secondary"
        >
          Cancel
        </AlertDialog.Cancel>
        <AlertDialog.Action
          class="alert-dialog-button alert-dialog-action button button--danger"
          value="delete"
          data-delete-project
        >
          Delete project
        </AlertDialog.Action>
      </div>
    </AlertDialog.Content>
  </AlertDialog.Root>

  <p class="alert-dialog-status" aria-live="polite" data-project-status></p>
</div>

<script>
  for (const project of document.querySelectorAll<HTMLElement>(
    "[data-project-deletion]",
  )) {
    const action = project.querySelector<HTMLButtonElement>(
      "[data-delete-project]",
    );
    const status = project.querySelector<HTMLElement>("[data-project-status]");

    action?.addEventListener("click", () => {
      if (status) status.textContent = "Project deleted.";
    });
  }
</script>
