---
import * as AlertDialog from "@ormo/primitives/alert-dialog";
import "./index.css";
import "./pending.css";
---

<div data-project-archive>
  <AlertDialog.Root>
    <AlertDialog.Trigger class="alert-dialog-trigger button">
      Archive project
    </AlertDialog.Trigger>

    <AlertDialog.Content class="alert-dialog-content" aria-busy="false">
      <AlertDialog.Title class="alert-dialog-title">
        Archive this project?
      </AlertDialog.Title>
      <AlertDialog.Description class="alert-dialog-description">
        Team members will no longer be able to make changes.
      </AlertDialog.Description>

      <div
        class="alert-dialog-actions button-group button-group--compact button-group--end"
      >
        <AlertDialog.Cancel
          class="alert-dialog-button button button--secondary"
        >
          Cancel
        </AlertDialog.Cancel>
        <AlertDialog.Action
          class="alert-dialog-button alert-dialog-primary button"
          value="archive"
          data-archive-action
        >
          <span class="alert-dialog-spinner" aria-hidden="true"></span>
          Archive project
        </AlertDialog.Action>
      </div>
    </AlertDialog.Content>
  </AlertDialog.Root>

  <p class="alert-dialog-status" aria-live="polite" data-archive-status></p>
</div>

<script>
  import { setButtonState } from "@ormo/primitives/button";
  import type { OrmoAlertDialogElement } from "@ormo/primitives/alert-dialog";

  for (const project of document.querySelectorAll<HTMLElement>(
    "[data-project-archive]",
  )) {
    const root =
      project.querySelector<OrmoAlertDialogElement>("ormo-alert-dialog");
    const content = project.querySelector<HTMLDialogElement>(
      "[data-ormo-alert-dialog-content]",
    );
    const action = project.querySelector<HTMLButtonElement>(
      "[data-archive-action]",
    );
    const status = project.querySelector<HTMLElement>("[data-archive-status]");

    action?.addEventListener("click", async (event) => {
      event.preventDefault();
      if (!root || !content) return;

      setButtonState(action, {
        pending: true,
        disabled: true,
        focusableWhenDisabled: true,
      });
      content.setAttribute("aria-busy", "true");

      await new Promise((resolve) => setTimeout(resolve, 1200));

      setButtonState(action, { pending: false, disabled: false });
      content.setAttribute("aria-busy", "false");
      root.close("archive");
      if (status) status.textContent = "Project archived.";
    });
  }
</script>
