---
import * as AlertDialog from "@ormo/primitives/alert-dialog";
import "./index.css";
---

<div>
  <div
    class="alert-dialog-actions button-group button-group--compact button-group--end"
  >
    <AlertDialog.Trigger
      for="detached-delete-dialog"
      class="alert-dialog-trigger button"
    >
      Delete from toolbar
    </AlertDialog.Trigger>
    <AlertDialog.Trigger
      for="detached-delete-dialog"
      class="alert-dialog-trigger button"
    >
      Delete from menu
    </AlertDialog.Trigger>
  </div>

  <AlertDialog.Root id="detached-delete-dialog">
    <AlertDialog.Content class="alert-dialog-content">
      <AlertDialog.Title class="alert-dialog-title">
        Delete this saved view?
      </AlertDialog.Title>
      <AlertDialog.Description class="alert-dialog-description">
        Everyone on the team will lose access to this saved view.
      </AlertDialog.Description>

      <div
        class="alert-dialog-actions button-group button-group--compact button-group--end"
      >
        <AlertDialog.Cancel
          class="alert-dialog-button button button--secondary"
        >
          Cancel
        </AlertDialog.Cancel>
        <AlertDialog.Action
          class="alert-dialog-button alert-dialog-action button button--danger"
        >
          Delete saved view
        </AlertDialog.Action>
      </div>
    </AlertDialog.Content>
  </AlertDialog.Root>
</div>
