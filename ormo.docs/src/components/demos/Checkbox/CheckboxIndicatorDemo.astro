---
import { Checkbox, CheckboxIndicator } from "@ormo/primitives/checkbox";
import "./index.css";
---

<label class="checkbox-custom-field">
  <Checkbox class="checkbox-custom" name="marketing" />
  <CheckboxIndicator class="checkbox-indicator">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M3 8.5 6.5 12 13 4"></path>
    </svg>
  </CheckboxIndicator>
  Send me product updates
</label>
