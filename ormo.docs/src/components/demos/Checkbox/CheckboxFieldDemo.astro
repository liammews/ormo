---
import { Checkbox, CheckboxIndicator } from "@ormo/primitives/checkbox";
import * as CheckboxGroup from "@ormo/primitives/checkbox/group";
import { Button } from "@ormo/primitives/button";
import * as Field from "@ormo/primitives/field";
import "./index.css";
---

<form class="checkbox-required-form">
  <Field.Root class="checkbox-group">
    <CheckboxGroup.Root
      class="checkbox-required-options"
      name="protocols"
      required
      requiredMessage="Select at least one protocol."
    >
      <CheckboxGroup.Label class="checkbox-group-label">
        Preferred package manager
      </CheckboxGroup.Label>
      <div class="checkbox-stack">
        <label class="checkbox-custom-field">
          <Checkbox class="checkbox-custom" value="http" />
          <CheckboxIndicator class="checkbox-indicator">
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path class="checkbox-checkmark" d="M3 8.5 6.5 12 13 4"></path>
              <path class="checkbox-mixedmark" d="M3 8h10"></path>
            </svg>
          </CheckboxIndicator>
          NPM
        </label>
        <label class="checkbox-custom-field">
          <Checkbox class="checkbox-custom" value="https" />
          <CheckboxIndicator class="checkbox-indicator">
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path class="checkbox-checkmark" d="M3 8.5 6.5 12 13 4"></path>
              <path class="checkbox-mixedmark" d="M3 8h10"></path>
            </svg>
          </CheckboxIndicator>
          Yarn
        </label>
        <label class="checkbox-custom-field">
          <Checkbox class="checkbox-custom" value="ssh" />
          <CheckboxIndicator class="checkbox-indicator">
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path class="checkbox-checkmark" d="M3 8.5 6.5 12 13 4"></path>
              <path class="checkbox-mixedmark" d="M3 8h10"></path>
            </svg>
          </CheckboxIndicator>
          Homebrew
        </label>
      </div>
    </CheckboxGroup.Root>
    <Field.Description class="checkbox-hint">
      Chose your preferred package manager.
    </Field.Description>
    <Field.Error class="checkbox-error" match="customError">
      Select at least one protocol.
    </Field.Error>
  </Field.Root>
  <Button class="button" type="submit">Save</Button>
</form>
