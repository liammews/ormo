---
import { Checkbox, CheckboxIndicator } from "@ormo/primitives/checkbox";
import * as CheckboxGroup from "@ormo/primitives/checkbox/group";
import "./index.css";
---

<CheckboxGroup.Root
  class="checkbox-group"
  name="apples"
  defaultValue={["fuji"]}
>
  <CheckboxGroup.Label class="checkbox-group-label">Apples</CheckboxGroup.Label>
  <div class="checkbox-stack">
    <label class="checkbox-custom-field checkbox-parent-row">
      <Checkbox class="checkbox-custom" parent />
      <CheckboxIndicator class="checkbox-indicator">
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path class="checkbox-checkmark" d="M3 8.5 6.5 12 13 4"></path>
          <path class="checkbox-mixedmark" d="M3 8h10"></path>
        </svg>
      </CheckboxIndicator>
      Select all
    </label>
    <label class="checkbox-custom-field">
      <Checkbox class="checkbox-custom" value="fuji" />
      <CheckboxIndicator class="checkbox-indicator">
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path class="checkbox-checkmark" d="M3 8.5 6.5 12 13 4"></path>
          <path class="checkbox-mixedmark" d="M3 8h10"></path>
        </svg>
      </CheckboxIndicator>
      Fuji
    </label>
    <label class="checkbox-custom-field">
      <Checkbox class="checkbox-custom" value="gala" />
      <CheckboxIndicator class="checkbox-indicator">
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path class="checkbox-checkmark" d="M3 8.5 6.5 12 13 4"></path>
          <path class="checkbox-mixedmark" d="M3 8h10"></path>
        </svg>
      </CheckboxIndicator>
      Gala
    </label>
    <label class="checkbox-custom-field">
      <Checkbox class="checkbox-custom" value="granny" />
      <CheckboxIndicator class="checkbox-indicator">
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path class="checkbox-checkmark" d="M3 8.5 6.5 12 13 4"></path>
          <path class="checkbox-mixedmark" d="M3 8h10"></path>
        </svg>
      </CheckboxIndicator>
      Granny Smith
    </label>
  </div>
</CheckboxGroup.Root>
