---
import * as Accordion from "@ormo/primitives/accordion";
import "../index.css";
import { ChevronDown } from "@lucide/astro";
---

<Accordion.Root class="accordion">
  <Accordion.Item class="accordion-item" value="about">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        What is Ormo?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Ormo is a library of unstyled UI components for building accessible
        design systems with Astro.
      </div>
    </Accordion.Content>
  </Accordion.Item>
  <Accordion.Item class="accordion-item" value="price">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        How much does it cost?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Nothing! Ormo is free and open source.
      </div>
    </Accordion.Content>
  </Accordion.Item>
  <Accordion.Item class="accordion-item" value="how-to">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        How do I use it?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Head to <a href="ormo.dev/docs">ormo.dev/docs</a> to get started.
      </div>
    </Accordion.Content>
  </Accordion.Item>
</Accordion.Root>
