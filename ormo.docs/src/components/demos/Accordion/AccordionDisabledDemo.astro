---
import * as Accordion from "@ormo/primitives/accordion";
import { ChevronDown } from "@lucide/astro";
import "./AccordionDemo.css";
---

<Accordion.Root class="accordion" defaultValue="shipping">
  <Accordion.Item class="accordion-item" value="shipping">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        Shipping information
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Standard shipping takes three to five working days.
      </div>
    </Accordion.Content>
  </Accordion.Item>
  <Accordion.Item class="accordion-item" value="returns" disabled>
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        Returns unavailable
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Returns are accepted within 30 days of delivery.
      </div>
    </Accordion.Content>
  </Accordion.Item>
  <Accordion.Item class="accordion-item" value="warranty">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        Warranty
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Every product includes a two-year limited warranty.
      </div>
    </Accordion.Content>
  </Accordion.Item>
</Accordion.Root>
