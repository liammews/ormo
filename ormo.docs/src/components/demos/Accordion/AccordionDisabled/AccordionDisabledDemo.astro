---
import * as Accordion from "@ormo/primitives/accordion";
import { ChevronDown } from "@lucide/astro";
import "../index.css";
---

<Accordion.Root class="accordion" defaultValue="shipping">
  <Accordion.Item class="accordion-item" value="shipping">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        Why doesn't Ormo include styling?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Ormo is designed to be a accessible primitive layer - we handle function
        and accessibility, you handle the presentation.
      </div>
    </Accordion.Content>
  </Accordion.Item>
  <Accordion.Item class="accordion-item" value="returns" disabled>
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        Will there be an styled version Ormo?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">Sneaky</div>
    </Accordion.Content>
  </Accordion.Item>
  <Accordion.Item class="accordion-item" value="warranty">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        Why wouldn't I just use a React library?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Ormo is a lightweight equivalent for sites that don't require additional
        frameworks.
      </div>
    </Accordion.Content>
  </Accordion.Item>
</Accordion.Root>
