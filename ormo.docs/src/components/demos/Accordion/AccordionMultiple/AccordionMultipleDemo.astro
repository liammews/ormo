---
import * as Accordion from "@ormo/primitives/accordion";
import { ChevronDown } from "@lucide/astro";
import "../index.css";
---

<Accordion.Root class="accordion" type="multiple">
  <Accordion.Item class="accordion-item" value="shipping">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        What is Astro?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Astro is a JavaScript web framework.
      </div>
    </Accordion.Content>
  </Accordion.Item>
  <Accordion.Item class="accordion-item" value="returns">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        Who uses Astro?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Google, OpenAI, Cloudflare and more.
      </div>
    </Accordion.Content>
  </Accordion.Item>
  <Accordion.Item class="accordion-item" value="warranty">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        How much does it cost?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Astro is free, open-source software.
      </div>
    </Accordion.Content>
  </Accordion.Item>
</Accordion.Root>
