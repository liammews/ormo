---
import * as Accordion from "@ormo/primitives/accordion";
import { ChevronDown } from "@lucide/astro";
import "./AccordionDemo.css";
---

<Accordion.Root
  class="accordion"
  defaultValue="about"
  data-accordion-demo="initial"
>
  <Accordion.Item class="accordion-item" value="about">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        What is Ormo?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Ormo is a headless component library for Astro.
      </div>
    </Accordion.Content>
  </Accordion.Item>
  <Accordion.Item class="accordion-item" value="price">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        How much does it cost?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">Ormo is free and open source.</div>
    </Accordion.Content>
  </Accordion.Item>
  <Accordion.Item class="accordion-item" value="how-to">
    <Accordion.Header class="accordion-header" as="h2">
      <Accordion.Trigger class="accordion-trigger">
        How do I use it?
        <ChevronDown class="indicator" size="14" aria-hidden="true" />
      </Accordion.Trigger>
    </Accordion.Header>
    <Accordion.Content class="accordion-content">
      <div class="accordion-content-inner">
        Head to the documentation to get started.
      </div>
    </Accordion.Content>
  </Accordion.Item>
</Accordion.Root>
