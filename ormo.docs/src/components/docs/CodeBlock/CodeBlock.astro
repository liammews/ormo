---
import { codeToHtml, type BundledLanguage } from "shiki";

import CopyButton from "../CopyButton/CopyButton.astro";

interface Props {
  code: string;
  lang?: BundledLanguage | "text" | "plaintext" | "txt";
  singleLine?: boolean;
}

const { code, lang = "text", singleLine = false } = Astro.props;
const highlightedCode = await codeToHtml(code, {
  lang,
  themes: {
    light: "github-light",
    dark: "github-dark-high-contrast",
  },
  defaultColor: false,
});
---

<div
  class:list={["code-block", singleLine && "code-block--single-line"]}
  data-code-block
>
  <div class="code-block_copy">
    <CopyButton />
  </div>

  <Fragment set:html={highlightedCode} />
</div>

<style>
  .code-block {
    position: relative;
    border-radius: var(--radius-3);
    overflow: clip;
    border: 1px solid var(--border-default);
    background: var(--surface-base);
  }

  .code-block_copy {
    position: absolute;
    inset-block-start: var(--space-50, 0.5rem);
    inset-inline-end: var(--space-50, 0.5rem);
    z-index: 1;
  }

  .code-block :global(pre) {
    margin: 0;
    overflow-x: auto;
    padding: var(--space-100) var(--space-100);
    font-family:
      var(--font-family-mono), ui-monospace, SFMono-Regular, Menlo, Monaco,
      Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-regular);
    line-height: 2;
    letter-spacing: var(--letter-spacing-base);
    tab-size: 2;
    background-color: transparent !important;
  }

  .code-block :global(pre code) {
    display: block;
    min-width: max-content;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
  }

  .code-block--single-line {
    block-size: 3.25rem;
  }

  .code-block--single-line :global(pre) {
    display: flex;
    block-size: 100%;
    align-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0;
    padding-inline: var(--space-100) 3.5rem;
  }
</style>

<style is:global>
  .code-block .shiki,
  .code-block .shiki span {
    color: var(--shiki-light) !important;
    font-style: var(--shiki-light-font-style) !important;
    font-weight: var(--shiki-light-font-weight) !important;
    text-decoration: var(--shiki-light-text-decoration) !important;
  }

  html[data-theme="dark"] .code-block .shiki,
  html[data-theme="dark"] .code-block .shiki span {
    color: var(--shiki-dark) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }

  @media (prefers-color-scheme: dark) {
    html:not([data-theme]) .code-block .shiki,
    html:not([data-theme]) .code-block .shiki span,
    html[data-theme="system"] .code-block .shiki,
    html[data-theme="system"] .code-block .shiki span {
      color: var(--shiki-dark) !important;
      font-style: var(--shiki-dark-font-style) !important;
      font-weight: var(--shiki-dark-font-weight) !important;
      text-decoration: var(--shiki-dark-text-decoration) !important;
    }
  }
</style>
