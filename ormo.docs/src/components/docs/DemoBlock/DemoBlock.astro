---
import { ChevronDown } from "@lucide/astro";
import * as Tabs from "@ormo/primitives/tabs";
import type { BundledLanguage } from "shiki";

import CodeBlock from "../CodeBlock/CodeBlock.astro";

interface DemoCodeFile {
  filename: string;
  code: string;
  lang?: BundledLanguage | "text" | "plaintext" | "txt";
}

interface Props {
  code?: string;
  files?: DemoCodeFile[];
}

const { code, files } = Astro.props;

function langFromFilename(
  filename: string,
): BundledLanguage | "text" | "plaintext" | "txt" {
  const ext = filename.split(".").pop()?.toLowerCase();

  switch (ext) {
    case "astro":
      return "astro";
    case "css":
      return "css";
    case "scss":
      return "scss";
    case "ts":
      return "typescript";
    case "tsx":
      return "tsx";
    case "js":
      return "javascript";
    case "jsx":
      return "jsx";
    case "json":
      return "json";
    case "html":
      return "html";
    case "md":
      return "markdown";
    case "mdx":
      return "mdx";
    default:
      return "text";
  }
}

const codeFiles: DemoCodeFile[] =
  files && files.length > 0
    ? files
    : code
      ? [{ filename: "code", code, lang: "astro" }]
      : [];

const showFileTabs = Boolean(files && files.length > 1);
const defaultFile = codeFiles[0]?.filename;
const codeId = `demo-code-${crypto.randomUUID()}`;
---

<div class="demoblock" data-demo-block>
  <div class="demoblock-canvas">
    <slot />
  </div>

  {
    codeFiles.length > 0 && (
      <div class="demoblock-code-container" data-demo-code-container>
        {showFileTabs ? (
          <Tabs.Root
            class="demoblock-code-tabs"
            defaultValue={defaultFile}
            activateOnFocus
          >
            <Tabs.List class="demoblock-code-tabs-list" aria-label="Code files">
              {codeFiles.map((file) => (
                <Tabs.Tab class="demoblock-code-tab" value={file.filename}>
                  {file.filename}
                </Tabs.Tab>
              ))}
            </Tabs.List>

            <div id={codeId} data-demo-code-panels>
              {codeFiles.map((file) => (
                <Tabs.Panel
                  class="demoblock-code-panel"
                  value={file.filename}
                >
                  <div
                    class="demoblock-code-content"
                    data-demo-code-content
                  >
                    <CodeBlock
                      code={file.code}
                      lang={file.lang ?? langFromFilename(file.filename)}
                    />
                  </div>
                </Tabs.Panel>
              ))}
            </div>
          </Tabs.Root>
        ) : (
          <div id={codeId} class="demoblock-code-content" data-demo-code-content>
            <CodeBlock
              code={codeFiles[0].code}
              lang={codeFiles[0].lang ?? langFromFilename(codeFiles[0].filename)}
            />
          </div>
        )}

        <button
          type="button"
          class="demoblock-code-toggle"
          aria-expanded="false"
          aria-controls={codeId}
          data-demo-code-toggle
          hidden
        >
          <span data-demo-code-toggle-label>Show all code</span>
          <ChevronDown
            class="demoblock-code-toggle-icon"
            size={16}
            aria-hidden="true"
          />
        </button>
      </div>
    )
  }
</div>

<script>
  const collapsedHeightInRem = 14;
  const blocks = document.querySelectorAll<HTMLElement>("[data-demo-block]");

  function measureContentHeight(content: HTMLElement): number {
    const panel = content.closest<HTMLElement>("[data-ormo-tabs-panel]");

    if (!panel || !panel.hidden) {
      return content.scrollHeight;
    }

    const previousPosition = panel.style.position;
    const previousVisibility = panel.style.visibility;
    const previousPointerEvents = panel.style.pointerEvents;
    const previousInlineSize = panel.style.inlineSize;

    panel.hidden = false;
    panel.style.position = "absolute";
    panel.style.visibility = "hidden";
    panel.style.pointerEvents = "none";
    // Taking the panel out of flow makes it shrink-to-fit, which would measure
    // the code at the wrong width, so pin it to the width it renders at.
    panel.style.inlineSize = `${panel.parentElement?.clientWidth ?? 0}px`;

    const height = content.scrollHeight;

    panel.hidden = true;
    panel.style.position = previousPosition;
    panel.style.visibility = previousVisibility;
    panel.style.pointerEvents = previousPointerEvents;
    panel.style.inlineSize = previousInlineSize;

    return height;
  }

  for (const block of blocks) {
    if (block.dataset.initialized === "true") continue;

    block.dataset.initialized = "true";

    const container = block.querySelector<HTMLElement>(
      "[data-demo-code-container]",
    );
    const contents = Array.from(
      block.querySelectorAll<HTMLElement>("[data-demo-code-content]"),
    );
    const toggle = block.querySelector<HTMLButtonElement>(
      "[data-demo-code-toggle]",
    );
    const label = block.querySelector<HTMLElement>(
      "[data-demo-code-toggle-label]",
    );

    if (!container || contents.length === 0 || !toggle || !label) continue;

    const tabsRoot = block.querySelector<HTMLElement>("[data-ormo-tabs-root]");

    const activeContent = (value?: string): HTMLElement | null => {
      if (contents.length === 1) return contents[0] ?? null;

      for (const content of contents) {
        const panel = content.closest<HTMLElement>("[data-ormo-tabs-panel]");

        if (!panel) continue;

        const matches =
          value === undefined
            ? panel.dataset.state === "active"
            : panel.dataset.value === value;

        if (matches) return content;
      }

      return contents[0] ?? null;
    };

    // Each file is measured on its own so a short file never inherits the
    // collapsed treatment from a long sibling tab.
    const measure = (): void => {
      const rootFontSize = Number.parseFloat(
        getComputedStyle(document.documentElement).fontSize,
      );
      const collapsedHeight = collapsedHeightInRem * rootFontSize;

      for (const content of contents) {
        content.toggleAttribute(
          "data-collapsible",
          measureContentHeight(content) > collapsedHeight,
        );
      }
    };

    const syncToggle = (value?: string): void => {
      const content = activeContent(value);

      toggle.hidden = !content?.hasAttribute("data-collapsible");
    };

    measure();
    syncToggle();

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      const nextExpanded = !expanded;

      toggle.setAttribute("aria-expanded", String(nextExpanded));
      container.toggleAttribute("data-expanded", nextExpanded);
      label.textContent = nextExpanded ? "Collapse code" : "Show all code";
    });

    // The event fires before the primitive applies the value, so sync
    // optimistically from the detail and confirm once the DOM has caught up.
    tabsRoot?.addEventListener("ormo:value-change", (event) => {
      syncToggle((event as CustomEvent<{ value: string }>).detail.value);
      requestAnimationFrame(() => syncToggle());
    });

    let lastWidth = container.clientWidth;

    new ResizeObserver(() => {
      const width = container.clientWidth;

      if (width === lastWidth) return;

      lastWidth = width;
      measure();
      syncToggle();
    }).observe(container);

    document.fonts.ready.then(() => {
      measure();
      syncToggle();
    });
  }
</script>

<style>
  .demoblock {
    width: 100%;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-3);
    overflow: clip;
    margin-block-end: var(--space-200);
  }

  .demoblock-canvas {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--space-100);
    background-color: var(--surface-canvas);
    min-height: 24rem;
    border-block-end: 1px solid var(--border-default);
  }

  .demoblock-code-container {
    background: var(--surface-base);
  }

  .demoblock-code-tabs {
    display: block;
  }

  .demoblock-code-tabs-list {
    display: flex;
    flex-wrap: wrap;
    background: var(--surface-canvas);
    border-block-end: 1px solid var(--border-default);
  }

  .demoblock-code-tab {
    margin: 0;
    margin-block-end: -1px;
    border: 0;
    border-inline-end: 1px solid var(--border-default);
    border-block-end: 1px solid transparent;
    padding: var(--space-50) var(--space-75);
    background: transparent;
    color: var(--content-subtle);
    font-family:
      var(--font-family-mono), ui-monospace, SFMono-Regular, Menlo, Monaco,
      Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-regular);
    line-height: 1.4;
    cursor: pointer;
  }

  .demoblock-code-tab:hover {
    color: var(--content-default);
  }

  .demoblock-code-tab[data-state="active"] {
    background: var(--surface-base);
    border-block-end-color: var(--surface-base);
    color: var(--content-default);
  }

  .demoblock-code-tab:focus-visible {
    outline: var(--focus-width) solid var(--focus-default);
    outline-offset: -2px;
  }

  .demoblock-code-tab:disabled,
  .demoblock-code-tab[data-disabled] {
    color: var(--content-disabled);
    cursor: not-allowed;
  }

  .demoblock-code-panel {
    outline: none;
  }

  .demoblock-code-content {
    position: relative;
  }

  .demoblock-code-container:not([data-expanded])
    .demoblock-code-content[data-collapsible] {
    max-block-size: 14rem;
    overflow: hidden;
  }

  .demoblock-code-container:not([data-expanded])
    .demoblock-code-content[data-collapsible]::after {
    position: absolute;
    inset: auto 0 0;
    block-size: 3rem;
    background: linear-gradient(transparent, var(--surface-base));
    content: "";
    pointer-events: none;
  }

  .demoblock-code-toggle {
    display: flex;
    width: 100%;
    min-block-size: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: var(--space-25);
    border: 0;
    border-block-start: 1px solid var(--border-default);
    border-radius: 0;
    padding: var(--space-50);
    background: var(--surface-canvas);
    color: var(--content-default);
    font: inherit;
    font-size: var(--font-size-2);
    cursor: pointer;
  }

  .demoblock-code-toggle[hidden] {
    display: none;
  }

  .demoblock-code-toggle:hover {
    background: var(--surface-elevated);
  }

  .demoblock-code-toggle:focus-visible {
    outline: var(--focus-width) solid var(--focus-default);
    outline-offset: -2px;
  }

  .demoblock-code-toggle-icon {
    transition: transform var(--duration-1) var(--ease-1);
  }

  .demoblock-code-toggle[aria-expanded="true"] .demoblock-code-toggle-icon {
    transform: rotate(180deg);
  }

  .demoblock :global(.code-block) {
    border: 0px;
    border-radius: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .demoblock-code-toggle-icon {
      transition: none;
    }
  }
</style>
