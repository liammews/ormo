---
type Status = "alpha" | "beta" | "production" | "dev";

interface Props {
  href: string;
  current?: boolean;
  status?: Status | undefined;
}

const statusLabels: Record<Status, string> = {
  alpha: "Alpha",
  beta: "Beta",
  production: "Production",
  dev: "Dev",
};

const { href, current = false, status } = Astro.props;
---

<li class="sidebar-menu-item">
  <a
    href={href}
    aria-current={current ? "page" : undefined}
    class="sidebar-menu-item_inner"
  >
    <span class="sidebar-menu-item_label"><slot /></span>
    {
      status ? (
        <span
          class="sidebar-menu-item_status"
          data-status={status}
          title={`${statusLabels[status]} status`}
        >
          <span class="visually-hidden">{statusLabels[status]} status</span>
        </span>
      ) : null
    }
  </a>
</li>

<style>
  .sidebar-menu-item_inner {
    display: flex;
    align-items: center;
    gap: var(--space-50);
    background: var(--surface-canvas);
    font-size: var(--font-size-2);
    color: var(--content-subtle);
    padding: var(--space-50) var(--space-75);
    width: 100%;
    transition: background var(--duration-1) var(--ease-1);

    &:hover {
      background: var(--surface-elevated);
      color: var(--content-primary);
    }

    &[aria-current] {
      background: var(--surface-invert);
      color: var(--content-invert);
      font-weight: var(--font-weight-medium);
    }
  }

  .sidebar-menu-item_label {
    min-width: 0;
  }

  .sidebar-menu-item_status {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    margin-inline-start: auto;
    border-radius: 50%;
    background: currentColor;

    &[data-status="beta"] {
      color: var(--color-blue-11);
    }

    &[data-status="production"] {
      color: var(--color-green-11);
    }

    &[data-status="alpha"] {
      color: var(--color-amber-11);
    }

    &[data-status="dev"] {
      color: var(--color-red-11);
    }
  }
</style>
