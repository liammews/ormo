---
import AvatarBrokenDemo from "../../../components/demos/Avatar/AvatarBrokenDemo.astro";
import AvatarInteractiveDemo from "../../../components/demos/Avatar/AvatarInteractiveDemo.astro";
import BrowserFixtureLayout from "../../../layouts/BrowserFixtureLayout.astro";

// The default, decorative, delayed, fallback-only and icon-fallback demos are
// presentation/fallback variants with no additional browser interaction. Their
// rendered contracts are covered by unit and Astro suites.
---

<BrowserFixtureLayout title="Avatar">
  <div data-avatar-demo="broken"><AvatarBrokenDemo /></div>
  <div data-avatar-demo="interactive"><AvatarInteractiveDemo /></div>
</BrowserFixtureLayout>

<script>
  document
    .querySelector('[data-avatar-demo="broken"] ormo-avatar')
    ?.setAttribute("id", "broken-avatar");
</script>
