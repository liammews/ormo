---
import PasswordFieldDemo from "../../../components/demos/PasswordField/PasswordFieldDemo.astro";
import BrowserFixtureLayout from "../../../layouts/BrowserFixtureLayout.astro";
---

<BrowserFixtureLayout title="Password Field">
  <div data-password-field-demo>
    <PasswordFieldDemo />
    <p aria-live="polite" data-password-field-status></p>
  </div>
</BrowserFixtureLayout>

<script>
  const form = document.querySelector<HTMLFormElement>(
    "[data-password-field-form]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-password-field-status]",
  );
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (status) status.textContent = "Password submitted.";
  });
</script>
