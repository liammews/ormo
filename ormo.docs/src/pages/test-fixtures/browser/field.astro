---
import FieldDemo from "../../../components/demos/Field/FieldDemo.astro";
import FieldDisabledDemo from "../../../components/demos/Field/FieldDisabledDemo.astro";
import FieldErrorDemo from "../../../components/demos/Field/FieldErrorDemo.astro";
import BrowserFixtureLayout from "../../../layouts/BrowserFixtureLayout.astro";
---

<BrowserFixtureLayout title="Field">
  <form id="field-default-demo-description" data-field-demo>
    <FieldDemo />
    <button type="submit" data-field-submit>Submit field</button>
  </form>
  <div data-field-error-demo><FieldErrorDemo /></div>
  <div data-field-disabled-demo><FieldDisabledDemo /></div>
</BrowserFixtureLayout>
