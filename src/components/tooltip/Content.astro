---
import type { TooltipContentProps } from "./types";

type Props = TooltipContentProps;

const {
  side = "top",
  align = "center",
  sideOffset = 0,
  style,
  ...attributes
}: Props = Astro.props;

function styleToCssText(value: unknown): string {
  if (value == null || value === false) {
    return "";
  }

  if (typeof value === "string") {
    return value.trim();
  }

  if (typeof value === "object") {
    return Object.entries(value as Record<string, unknown>)
      .filter(([, entry]) => entry != null && entry !== false)
      .map(([property, entry]) => {
        const cssProperty = property.startsWith("--")
          ? property
          : property.replace(/[A-Z]/g, (match) => `-${match.toLowerCase()}`);
        return `${cssProperty}: ${String(entry)}`;
      })
      .join("; ");
  }

  return "";
}

const sideOffsetStyle = `--ormo-tooltip-side-offset: ${sideOffset}px`;
const authoredStyle = styleToCssText(style);
const mergedStyle = authoredStyle
  ? `${authoredStyle}; ${sideOffsetStyle}`
  : sideOffsetStyle;
---

<div
  {...attributes}
  role="tooltip"
  popover="manual"
  data-side={side}
  data-align={align}
  data-ormo-tooltip-content
  data-state="closed"
  style={mergedStyle}
>
  <slot />
</div>
