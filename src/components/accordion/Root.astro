---
import type { AccordionOrientation, AccordionRootProps } from "./types";

type Props = Omit<AccordionRootProps, "orientation"> & {
  orientation?: AccordionOrientation;
};

const {
  type = "single",
  collapsible = false,
  defaultValue,
  disabled = false,
  hiddenUntilFound = false,
  orientation = "vertical",
  ...attributes
} = Astro.props;

const serializedDefaultValue =
  defaultValue === undefined ? undefined : JSON.stringify(defaultValue);
---

<ormo-accordion
  {...attributes}
  data-ormo-accordion-root
  data-type={type}
  data-orientation={orientation}
  data-collapsible={collapsible ? "" : undefined}
  data-disabled={disabled ? "" : undefined}
  data-hidden-until-found={hiddenUntilFound ? "" : undefined}
  data-default-value={serializedDefaultValue}
>
  <slot />
</ormo-accordion>

<script>
  import "../../runtime/accordion";
</script>
