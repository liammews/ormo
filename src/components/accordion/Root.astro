---
import {
  normalizeDefaultOpenValues,
  renderWithAccordionContext,
} from "../../internal/accordion-ssr-context";
import type { AccordionRootProps } from "./types";

type Props = AccordionRootProps;

const {
  type = "single",
  collapsible = true,
  defaultValue,
  disabled = false,
  hiddenUntilFound = false,
  orientation = "vertical",
  ...attributes
} = Astro.props;

const serializedDefaultValue =
  defaultValue === undefined ? undefined : JSON.stringify(defaultValue);

const content = await renderWithAccordionContext(
  {
    type,
    collapsible,
    openValues: normalizeDefaultOpenValues(type, defaultValue),
    hiddenUntilFound,
  },
  () => Astro.slots.render("default"),
);
---

<ormo-accordion
  {...attributes}
  data-ormo-accordion-root
  data-type={type}
  data-orientation={orientation}
  data-collapsible={collapsible ? undefined : "false"}
  data-disabled={disabled ? "" : undefined}
  data-hidden-until-found={hiddenUntilFound ? "" : undefined}
  data-default-value={serializedDefaultValue}
  set:html={content}
/>

<script>
  import "../../runtime/accordion";
</script>
