---
import {
  getAccordionItemSsrContext,
  getAccordionSsrContext,
} from "../../internal/accordion-ssr-context";
import type { AccordionContentProps } from "./types";

type Props = AccordionContentProps;

const { hiddenUntilFound, ...attributes } = Astro.props;
const accordion = getAccordionSsrContext();
const item = getAccordionItemSsrContext();
const open = item?.open ?? false;
const untilFound = hiddenUntilFound ?? accordion?.hiddenUntilFound ?? true;
---

<div
  {...attributes}
  data-ormo-accordion-content
  data-state={open ? "open" : "closed"}
  data-open={open ? "" : undefined}
  aria-hidden={open ? undefined : "true"}
  inert={open || untilFound ? undefined : true}
  hidden={open ? undefined : untilFound ? "until-found" : true}
  data-hidden-until-found={hiddenUntilFound === undefined
    ? undefined
    : hiddenUntilFound
      ? ""
      : "false"}
>
  <slot />
</div>
