---
import type { PopoverRootProps } from "./types";

type Props = PopoverRootProps;

const {
  disablePointerDismissal = false,
  positioning = "css-anchor",
  ...attributes
}: Props = Astro.props;
---

<ormo-popover
  {...attributes}
  data-disable-pointer-dismissal={disablePointerDismissal || undefined}
  data-positioning={positioning === "floating" ? "floating" : undefined}
  data-ormo-popover-root
  data-state="closed"
>
  <slot />
</ormo-popover>

<script>
  import "../../runtime/popover";
</script>
