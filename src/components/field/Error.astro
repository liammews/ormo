---
import type { FieldErrorProps } from "./types";

type Props = FieldErrorProps;

const { match, ...attributes }: Props = Astro.props;
const serializedMatch =
  match === undefined
    ? undefined
    : typeof match === "boolean"
      ? String(match)
      : match;
// Stay hidden in SSR unless match={true}. The field runtime reveals errors when
// they apply, which avoids flashing invalid copy before JavaScript connects.
const initiallyHidden = match !== true;
---

<div
  {...attributes}
  data-ormo-field-error
  data-match={serializedMatch}
  role="alert"
  hidden={initiallyHidden}
>
  <slot />
</div>
