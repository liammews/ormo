---
import type { FieldErrorProps } from "./types";
import { getFieldSsrContext } from "../../internal/field-ssr-context";

type Props = FieldErrorProps;

const { match, id, ...attributes }: Props = Astro.props;
const field = getFieldSsrContext();
const serializedMatch =
  match === undefined
    ? undefined
    : typeof match === "boolean"
      ? String(match)
      : match;
const errorIndex = field ? ++field.errorCount : undefined;
const errorId =
  id ??
  (field && errorIndex ? `${field.rootId}-error-${errorIndex}` : undefined);
// A generic error can reflect an explicitly invalid server state. Native
// validity-specific matches remain hidden until the browser evaluates them.
const initiallyHidden =
  match === true ? false : match === undefined && field?.invalid ? false : true;
---

<div
  {...attributes}
  id={errorId}
  data-ormo-field-error
  data-match={serializedMatch}
  data-invalid={field?.invalid ? "" : undefined}
  role="alert"
  hidden={initiallyHidden}
>
  <slot />
</div>
