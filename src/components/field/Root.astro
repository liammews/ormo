---
import type { FieldRootProps } from "./types";
import {
  createFieldRootId,
  renderWithFieldContext,
} from "../../internal/field-ssr-context";

type Props = FieldRootProps;

const {
  invalid = false,
  id,
  validationMode = "onSubmit",
  validationDebounceTime = 0,
  ...attributes
}: Props = Astro.props;

const rootId = id ?? createFieldRootId();
const content = await renderWithFieldContext(
  {
    invalid,
    rootId,
    controlId: `${rootId}-control`,
    labelCount: 0,
    descriptionCount: 0,
    errorCount: 0,
  },
  () => Astro.slots.render("default"),
);
---

<ormo-field
  {...attributes}
  id={rootId}
  data-ormo-field-root
  data-invalid={invalid ? "" : undefined}
  data-validation-mode={validationMode}
  data-validation-debounce-time={validationDebounceTime > 0
    ? String(validationDebounceTime)
    : undefined}
  set:html={content}
/>

<script>
  import "../../runtime/field";
</script>
