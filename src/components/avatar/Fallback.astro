---
import { getAvatarSsrContext } from "../../internal/avatar-ssr-context";
import type { AvatarFallbackProps } from "./types";

type Props = AvatarFallbackProps;

const { delay, ...attributes }: Props = Astro.props;
const context = getAvatarSsrContext();
const delayMs =
  typeof delay === "number" && Number.isFinite(delay) && delay > 0
    ? Math.floor(delay)
    : undefined;
const hideForSsr = context?.hasImageSource === true && delayMs !== undefined;
---

<span
  {...attributes}
  data-ormo-avatar-fallback
  data-delay={delayMs}
  hidden={hideForSsr || undefined}
>
  <slot />
</span>
