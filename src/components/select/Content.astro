---
import type { SelectContentProps } from "./types";

type Props = SelectContentProps;

const {
  side = "bottom",
  align = "start",
  sideOffset = 0,
  style,
  ...attributes
}: Props = Astro.props;

function styleToCssText(value: unknown): string {
  if (value == null || value === false) return "";
  if (typeof value === "string") return value.trim();
  if (typeof value !== "object") return "";
  return Object.entries(value as Record<string, unknown>)
    .filter(([, entry]) => entry != null && entry !== false)
    .map(([property, entry]) => {
      const cssProperty = property.startsWith("--")
        ? property
        : property.replace(/[A-Z]/g, (match) => `-${match.toLowerCase()}`);
      return `${cssProperty}: ${String(entry)}`;
    })
    .join("; ");
}

const authoredStyle = styleToCssText(style);
const offsetStyle = `--ormo-select-side-offset: ${sideOffset}px`;
const mergedStyle = authoredStyle
  ? `${authoredStyle}; ${offsetStyle}`
  : offsetStyle;
---

<div
  {...attributes}
  role="listbox"
  popover="auto"
  tabindex="-1"
  data-ormo-select-content
  data-side={side}
  data-align={align}
  data-state="closed"
  style={mergedStyle}
>
  <slot />
</div>
