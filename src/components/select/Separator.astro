---
import { getSelectSsrContext } from "../../internal/select-ssr-context";
import type { SelectSeparatorProps } from "./types";

type Props = SelectSeparatorProps;

const attributes: Props = Astro.props;
const select = getSelectSsrContext();
---

{
  select?.native ? (
    <hr {...attributes} data-ormo-select-separator />
  ) : (
    <div {...attributes} aria-hidden="true" data-ormo-select-separator />
  )
}
