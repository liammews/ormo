---
import {
  getSelectGroupSsrContext,
  getSelectSsrContext,
  htmlToText,
} from "../../internal/select-ssr-context";
import type { SelectGroupLabelProps } from "./types";

type Props = SelectGroupLabelProps;

const { id, ...attributes }: Props = Astro.props;
const select = getSelectSsrContext();
const group = getSelectGroupSsrContext();
const content = await Astro.slots.render("default");
const resolvedId = id ?? group?.labelId;
if (group) {
  group.label = htmlToText(content);
  if (resolvedId) group.labelId = resolvedId;
}
---

{
  !select?.native && (
    <div
      {...attributes}
      id={resolvedId}
      data-ormo-select-group-label
      set:html={content}
    />
  )
}
