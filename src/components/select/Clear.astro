---
import type { SelectClearProps } from "./types";

type Props = SelectClearProps;

const { disabled = false, ...attributes }: Props = Astro.props;
---

<button
  {...attributes}
  type="button"
  disabled={disabled || undefined}
  data-item-disabled={disabled ? "" : undefined}
  data-ormo-select-clear
>
  <slot />
</button>
