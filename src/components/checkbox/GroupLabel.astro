---
import { getCheckboxGroupSsrContext } from "../../internal/checkbox-group-ssr-context";
import type { CheckboxGroupLabelProps } from "./types";

type Props = CheckboxGroupLabelProps;

const { id, ...attributes }: Props = Astro.props;
const group = getCheckboxGroupSsrContext();

const labelId =
  id ??
  (group
    ? group.labelIds.length === 0
      ? group.labelId
      : `${group.labelId}-${group.labelIds.length + 1}`
    : undefined);

if (group && labelId) {
  group.labelIds.push(labelId);
}
---

<span {...attributes} id={labelId} data-ormo-checkbox-group-label>
  <slot />
</span>
