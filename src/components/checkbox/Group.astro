---
import {
  createCheckboxGroupRootId,
  normalizeDefaultValues,
  renderWithCheckboxGroupContext,
} from "../../internal/checkbox-group-ssr-context";
import { getFieldSsrContext } from "../../internal/field-ssr-context";
import type { CheckboxGroupRootProps } from "./types";

type Props = CheckboxGroupRootProps;

const {
  name,
  defaultValue,
  disabled = false,
  required = false,
  requiredMessage,
  id,
  "aria-labelledby": ariaLabelledBy,
  "aria-label": ariaLabel,
  "aria-invalid": ariaInvalid,
  ...attributes
} = Astro.props as CheckboxGroupRootProps & {
  required?: boolean;
  requiredMessage?: string;
  id?: string;
  "aria-labelledby"?: string;
  "aria-label"?: string;
  "aria-invalid"?: string;
};

const field = getFieldSsrContext();
const rootId = id ?? createCheckboxGroupRootId();
const labelId = `${rootId}-label`;
const serializedDefaultValue =
  defaultValue === undefined ? undefined : JSON.stringify(defaultValue);

const ssrContext = {
  name,
  disabled,
  defaultValue: normalizeDefaultValues(defaultValue),
  rootId,
  labelId,
  labelIds: [],
  memberCount: 0,
  checkedMemberCount: 0,
};

const content = await renderWithCheckboxGroupContext(ssrContext, () =>
  Astro.slots.render("default"),
);

const generatedLabelledBy =
  ariaLabelledBy === undefined && !ariaLabel && ssrContext.labelIds.length > 0
    ? ssrContext.labelIds.join(" ")
    : undefined;
const resolvedLabelledBy = ariaLabelledBy ?? generatedLabelledBy;
const initialState =
  ssrContext.checkedMemberCount === 0
    ? "none"
    : ssrContext.checkedMemberCount === ssrContext.memberCount
      ? "all"
      : "partial";
---

<ormo-checkbox-group
  {...attributes}
  id={rootId}
  role="group"
  aria-labelledby={resolvedLabelledBy}
  aria-label={ariaLabel}
  aria-invalid={ariaInvalid ?? (field?.invalid ? "true" : undefined)}
  data-ormo-checkbox-group
  data-state={initialState}
  data-disabled={disabled ? "" : undefined}
  data-required={required ? "" : undefined}
  data-invalid={field?.invalid ? "" : undefined}
  data-ormo-field-inherited-invalid={field?.invalid ? "" : undefined}
  data-name={name}
  data-default-value={serializedDefaultValue}
  data-managed-labelledby={generatedLabelledBy}
  data-required-message={required ? requiredMessage : undefined}
  set:html={content}
/>

<script>
  import "../../runtime/checkbox-group";
</script>
