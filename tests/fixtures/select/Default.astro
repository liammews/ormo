---
import * as Select from "../../../src/components/select/index";
---

<label for="country-control">Country</label>
<Select.Root id="country" name="country" defaultValue="fr" required>
  <Select.Trigger>
    <Select.Value placeholder="Choose a country" />
    <Select.Icon>⌄</Select.Icon>
  </Select.Trigger>
  <Select.Clear aria-label="Clear country">×</Select.Clear>
  <Select.Content sideOffset={4}>
    <Select.Group id="europe">
      <Select.GroupLabel>Europe</Select.GroupLabel>
      <Select.Item value="gb">United Kingdom</Select.Item>
      <Select.Item value="fr">
        France
        <Select.ItemIndicator>
          <svg aria-hidden="true"><path d="M1 1"></path></svg>
        </Select.ItemIndicator>
      </Select.Item>
      <Select.Item value="entity">
        Caf&eacute; &#169; &#x1F680; &NotEqualTilde;
      </Select.Item>
    </Select.Group>
    <Select.Group id="north-america">
      <Select.GroupLabel>North America</Select.GroupLabel>
      <Select.Item value="ca">Canada</Select.Item>
      <Select.Item value="us" disabled>United States</Select.Item>
    </Select.Group>
  </Select.Content>
</Select.Root>
