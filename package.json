{
  "name": "@ormo/primitives",
  "version": "0.0.0",
  "description": "Accessible, unstyled UI primitives for Astro.",
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./accordion": {
      "types": "./src/components/accordion/index.ts",
      "import": "./src/components/accordion/index.ts"
    },
    "./alert-dialog": {
      "types": "./src/components/alert-dialog/index.ts",
      "import": "./src/components/alert-dialog/index.ts"
    },
    "./avatar": {
      "types": "./src/components/avatar/index.ts",
      "import": "./src/components/avatar/index.ts"
    },
    "./button": {
      "types": "./src/components/button/index.ts",
      "import": "./src/components/button/index.ts"
    },
    "./breadcrumbs": {
      "types": "./src/components/breadcrumbs/index.ts",
      "import": "./src/components/breadcrumbs/index.ts"
    },
    "./checkbox": {
      "types": "./src/components/checkbox/index.ts",
      "import": "./src/components/checkbox/index.ts"
    },
    "./checkbox/group": {
      "types": "./src/components/checkbox/group.ts",
      "import": "./src/components/checkbox/group.ts"
    },
    "./dialog": {
      "types": "./src/components/dialog/index.ts",
      "import": "./src/components/dialog/index.ts"
    },
    "./dev-toolbar": {
      "types": "./src/dev-toolbar/index.ts",
      "import": "./src/dev-toolbar/index.ts"
    },
    "./field": {
      "types": "./src/components/field/index.ts",
      "import": "./src/components/field/index.ts"
    },
    "./fieldset": {
      "types": "./src/components/fieldset/index.ts",
      "import": "./src/components/fieldset/index.ts"
    },
    "./input": {
      "types": "./src/components/input/index.ts",
      "import": "./src/components/input/index.ts"
    },
    "./popover": {
      "types": "./src/components/popover/index.ts",
      "import": "./src/components/popover/index.ts"
    },
    "./popover/floating": {
      "types": "./src/components/popover/floating.ts",
      "import": "./src/components/popover/floating.ts"
    },
    "./select": {
      "types": "./src/components/select/index.ts",
      "import": "./src/components/select/index.ts"
    },
    "./select/floating": {
      "types": "./src/components/select/floating.ts",
      "import": "./src/components/select/floating.ts"
    },
    "./tabs": {
      "types": "./src/components/tabs/index.ts",
      "import": "./src/components/tabs/index.ts"
    },
    "./tooltip": {
      "types": "./src/components/tooltip/index.ts",
      "import": "./src/components/tooltip/index.ts"
    },
    "./tooltip/floating": {
      "types": "./src/components/tooltip/floating.ts",
      "import": "./src/components/tooltip/floating.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests && vitest run --config vitest.astro.config.ts --passWithNoTests",
    "test:watch": "vitest",
    "test:astro": "vitest run --config vitest.astro.config.ts",
    "test:browser": "pnpm docs:build && playwright test",
    "test:browser:ci": "pnpm docs:build && playwright test --project=chromium",
    "validate:library": "pnpm format:check && pnpm lint && pnpm check && pnpm test",
    "validate:docs": "pnpm --dir ormo.docs validate",
    "validate": "pnpm validate:library && pnpm validate:docs",
    "docs:dev": "pnpm --dir ormo.docs dev",
    "docs:build": "pnpm --dir ormo.docs build",
    "docs:preview": "pnpm --dir ormo.docs preview",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@floating-ui/dom": "^1.7.0",
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@floating-ui/dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "astro": "^7.0.9",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.12.0",
  "publishConfig": {
    "access": "public"
  }
}
